{
	"name": "pocketfm-contest-forge",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": "22.x"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"test:browser": "node scripts/browser-smoke.mjs",
		"verify": "node scripts/verify-all.mjs",
		"verify:guards": "npm run guard:repo-hygiene && npm run guard:module-shape && npm run guard:no-live-fallback && npm run guard:eslint-disable-rationale && npm run guard:type-escape-budget",
		"verify:ui": "node scripts/verify-ui.mjs",
		"ai:smoke": "node scripts/live-ai-smoke.mjs",
		"deploy:readiness": "node scripts/check-deploy-readiness.mjs",
		"scaffold:module": "node scripts/scaffold-story-module.mjs",
		"guard:repo-hygiene": "node scripts/guard-repo-hygiene.mjs",
		"guard:module-shape": "node scripts/guard-module-shape.mjs",
		"guard:no-live-fallback": "node scripts/guard-no-live-fallback.mjs",
		"guard:eslint-disable-rationale": "node scripts/guard-eslint-disable-rationale.mjs",
		"guard:type-escape-budget": "node scripts/guard-type-escape-budget.mjs",
		"guard:docs-drift": "node scripts/guard-docs-drift.mjs",
		"hooks:install": "node scripts/install-git-hooks.mjs",
		"prepush": "node scripts/pre-push-check.mjs",
		"lint": "node scripts/lint.mjs",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/node": "^22",
		"devalue": "^5.8.1",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7",
		"vitest": "^4.1.3"
	},
	"dependencies": {
		"zod": "^4.4.3"
	}
}
